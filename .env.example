# Copy this file to .env and fill in the values. Never commit .env.

# Which prescription reader to use: gemini | anthropic | textract
PRESCRIPTION_PROVIDER=gemini

# Gemini (default provider). Free tier, no billing: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic / Claude (when PRESCRIPTION_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# AWS Textract (when PRESCRIPTION_PROVIDER=textract).
# Textract does OCR and Gemini interprets the text, so this mode also needs GEMINI_API_KEY.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Supabase (from Alan, or your own project's API settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — required for the reminder cron (bypasses RLS). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Twilio WhatsApp (Sandbox-first)
# Setup: https://www.twilio.com/try-twilio
# 1. Copy Account SID + Auth Token from Console > Account > API keys & tokens
# 2. Activate Sandbox: Console > Messaging > Try it out > Send a WhatsApp message
# 3. On your phone, text "join <code>" to +1 415 523 8886
# 4. Sandbox Appointment Reminders Content SID (default below) — confirm in Console
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Pre-approved sandbox template: "Your appointment is coming up on {{1}} at {{2}}"
TWILIO_WHATSAPP_CONTENT_SID=HXb5b62575e6e4ff6129ad7c8efe1f983e

# Protects POST /api/cron/dispatch-reminders (Authorization: Bearer <secret>)
CRON_SECRET=
